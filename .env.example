# Pushover Credentials (Required for push alerts; never stored in SQLite)
PUSHOVER_USER_KEY=your_pushover_user_key_here
PUSHOVER_API_TOKEN=your_pushover_app_api_token_here

# Optional: Restrict alerts to a specific Pushover device name
PUSHOVER_DEVICE=

# Container Runtime Settings
PORT=8080
TZ=UTC
DB_PATH=/data/apple-stock.db
